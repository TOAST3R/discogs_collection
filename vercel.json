{
  "installCommand": "npm install && npm --prefix client install",
  "buildCommand": "CI=false REACT_APP_API_URL=/api npm run build",
  "outputDirectory": "client/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
